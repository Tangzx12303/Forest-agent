# Database credentials; the application creates forest_wellness and its tables.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_local_mysql_password
MYSQL_DATABASE=forest_wellness

# Optional launcher settings for `python run.py`.
# APP_HOST=127.0.0.1
# APP_PORT=8000
# APP_OPEN_BROWSER=false

# Optional local learning loop. Turning capture on writes raw chat turns to a
# local JSONL file; leave it off if you do not want transcripts on disk.
# TRAINING_CAPTURE=false
# TRAINING_LOG_PATH=data/training/turns.jsonl
# TOOL_ROUTER_MODEL=data/training/tool_router.pt
# TOOL_ROUTER_HINT_THRESHOLD=0.35

# DashScope supports chat and text-embedding-v4.
DASHSCOPE_API_KEY=your_dashscope_api_key
EMBEDDING_MODEL_NAME=text-embedding-v4

# Optional compatible providers. Only configured keys appear in the model selector.
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ZHIPUAI_API_KEY=
# MOONSHOT_API_KEY=

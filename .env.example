# MySQL 连接信息；应用启动时会自动创建数据库和所需数据表。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_local_mysql_password
MYSQL_DATABASE=forest_wellness

# 生产环境必填：请生成固定的随机会话密钥并妥善保管。
# APP_SESSION_SECRET=
# 使用 HTTPS 部署时启用安全 Cookie。
# APP_COOKIE_SECURE=true

# 百炼 API 密钥，用于聊天模型和文本向量化。
DASHSCOPE_API_KEY=your_dashscope_api_key

# 可选：启用对应供应商后，该模型才会显示在模型选择器中。
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ZHIPUAI_API_KEY=
# MOONSHOT_API_KEY=

# 可选：将每轮原始对话保存到本地训练记录；默认关闭以保护隐私。
TRAINING_CAPTURE=false
